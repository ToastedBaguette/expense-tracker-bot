# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Configuration
# The ID from your sheet URL (e.g. 1LRGekJQ0mUugQbWRs_2lzYeEk7nBPHKdcdveOgTmk_I)
SPREADSHEET_ID=1LRGekJQ0mUugQbWRs_2lzYeEk7nBPHKdcdveOgTmk_I

# Google Service Account Credentials path or direct JSON
# If using a Service Account file:
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# Authorized WhatsApp Phone Numbers (with country code, e.g. 6281234567890)
# Comma-separated if multiple
AUTHORIZED_NUMBERS=6282112345678

# Bot Name / Prefix (optional)
BOT_NAME="Expense Bot"
