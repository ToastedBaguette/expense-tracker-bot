# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Platform selection: "discord" or "whatsapp" (skips interactive prompt, useful for Docker)
# PLATFORM=discord

# Google Sheets Configuration
SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# If using OAuth instead of service account, uncomment these:
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token

# --- DISCORD CONFIGURATION ---
# Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# (Optional) Specific channel ID so bot only responds there
DISCORD_CHANNEL_ID=

# (Optional) Your Discord user ID to restrict who can trigger the bot
DISCORD_AUTHORIZED_USERS=

# --- WHATSAPP CONFIGURATION (Optional if using WhatsApp) ---
AUTHORIZED_NUMBERS=628XXXXXXXXXX
